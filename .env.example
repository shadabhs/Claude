# ---- Database ----
# Provider: "postgresql" (Supabase / local) or "mysql" (Hostinger).
# The schema is portable across both; pick the one matching your host.
DB_PROVIDER="postgresql"

# Connection string for the chosen provider.
# Postgres example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# MySQL example:    mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ---- Auth ----
# Secret for signing session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# ---- Server Actions encryption key ----
# Pins the key Next.js uses to encrypt Server Action references. REQUIRED on any
# host that runs multiple worker processes or does rolling restarts (e.g. Hostinger)
# — otherwise each process generates its own key and form submits fail with
# "Failed to find Server Action ...". Must be present at BUILD and runtime.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-a-base64-32-byte-key"

# ---- Seed (used once by `npm run db:seed`) ----
SEED_DOCTOR_EMAIL="imran@example.com"
SEED_DOCTOR_PASSWORD="change-this-strong-password"
SEED_DOCTOR_NAME="Dr. Imran"
